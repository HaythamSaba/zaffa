# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the marketing site (used for metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Root domain for couple subdomains, e.g. zaffa.com. Locally, use
# localhost so layla-and-adam.localhost:3000 resolves to the couple.
ROOT_DOMAIN=localhost

# Comma-separated hosts (no port) that serve the marketing site, e.g.
# zaffa.vercel.app,zaffa.com,www.zaffa.com. localhost, 127.0.0.1 and
# Vercel's own deployment URLs are always marketing hosts.
MARKETING_HOSTS=

# Slug of the demo couple served at /sample on the marketing hosts.
DEMO_SLUG=layla-and-adam

# --- Supabase (EU region, Frankfurt) ---
# Dashboard → Project Settings → API Keys (or `npx supabase projects api-keys`).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable (or legacy anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never import in
# client components (lib/supabase/admin.ts is guarded by `server-only`).
SUPABASE_SERVICE_ROLE_KEY=

# --- Couple dashboard ---
# Server-only. Signs the dashboard session cookie (HMAC-SHA256). At least 32
# random characters, e.g. `openssl rand -base64 32`. Never prefix with
# NEXT_PUBLIC_. Rotating it logs every couple's dashboard out.
DASHBOARD_SESSION_SECRET=

# --- Contact form (Resend) ---
# Server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=

# Sender address. Until your domain is verified in Resend, use Resend's test
# sender "onboarding@resend.dev". NOTE: the test sender only delivers to the
# email address of your own Resend account, so CONTACT_TO_EMAIL must be that
# address until the domain is verified.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Set to 1 to skip sending email (local dev / e2e). Ignored when
# NODE_ENV=production, so it can never silently disable the live form.
CONTACT_DRY_RUN=
