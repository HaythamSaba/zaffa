# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the marketing site (used for metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Root domain for couple subdomains (phase 2), e.g. zaffa.com
ROOT_DOMAIN=localhost:3000

# --- Contact form (Resend) ---
# Server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=

# Sender address. Until your domain is verified in Resend, use Resend's test
# sender "onboarding@resend.dev". NOTE: the test sender only delivers to the
# email address of your own Resend account, so CONTACT_TO_EMAIL must be that
# address until the domain is verified.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Set to 1 to skip sending email (local dev / e2e). Ignored when
# NODE_ENV=production, so it can never silently disable the live form.
CONTACT_DRY_RUN=
